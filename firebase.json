{
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "bounce-tower",
          "appId": "1:760562010684:android:5120201efc97f2c9655139",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "bounce-tower",
          "appId": "1:760562010684:ios:451a67d627acd908655139",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "bounce-tower",
          "configurations": {
            "android": "1:760562010684:android:5120201efc97f2c9655139",
            "ios": "1:760562010684:ios:451a67d627acd908655139"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/hosting",
    "predeploy": [
      "bash \"$PROJECT_DIR/tool/build_hosting.sh\""
    ],
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
